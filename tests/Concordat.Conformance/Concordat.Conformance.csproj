<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The fixtures ship as loose JSON beside the assembly rather than as embedded resources,
      so another language's runner can read exactly the same files (ADR-019).
    -->
    <Content Include="corpus\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\Concordat.Application\Concordat.Application.csproj" />
    <ProjectReference Include="..\..\src\formats\Concordat.Formats.Avro\Concordat.Formats.Avro.csproj" />
    <ProjectReference Include="..\..\src\formats\Concordat.Formats.Json\Concordat.Formats.Json.csproj" />
    <ProjectReference Include="..\..\src\formats\Concordat.Formats.Protobuf\Concordat.Formats.Protobuf.csproj" />
  </ItemGroup>

</Project>