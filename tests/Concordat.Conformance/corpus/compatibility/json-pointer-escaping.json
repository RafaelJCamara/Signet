  "contentModel": "open",
  "policy": { "mode": "BACKWARD", "surface": "WIRE_JSON" },
  "previous": [{ "ordinal": 1, "schema": "{\"properties\":{\"a/b\":{\"type\":[\"string\",\"null\"]}}}" }],
  "proposed": "{\"properties\":{\"a/b\":{\"type\":\"string\"}}}",
  "expected": {
    "compatible": false,
    "suggestedBump": "MAJOR",
    "breakingChanges": [
      { "path": "#/properties/a~1b", "kind": "type_narrowed", "direction": "BACKWARD", "surface": "WIRE_JSON" }
    ]
  }
}
