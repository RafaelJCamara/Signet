<Project>
  <!--
    Central Package Management. Versions live here and nowhere else; project files
    carry <PackageReference Include="..." /> with no Version attribute.

    Adding a version in a .csproj is a build error (NU1008), which is the point:
    with 12 projects today and ~25 by M6, per-project versions drift silently.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Core">
    <!-- Abstractions only: the Application layer registers handlers, it does not host. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!--
      M8.1 password hashing only. PasswordHasher<T> is PBKDF2-HMAC-SHA512 with a per-password
      salt, a self-describing format, and an iteration count Microsoft raises across releases.
      ADR-008 accepts that built-in identity means owning password storage; owning it
      responsibly means not hand-rolling the part that has been broken in public a hundred
      times. None of Identity's stores, managers or UI are used.
    -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <!--
      M9.1 Cloud key protection. The key ring is persisted in PostgreSQL either way; these wrap
      it so the keys that decrypt every stored broker credential are not sitting in the same
      database as the ciphertext. MIT, and reached only when a key URI is configured.
    -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!--
      M7.5 email delivery. MIT, and the option Microsoft's own SmtpClient documentation points
      at: System.Net.Mail.SmtpClient is explicitly not recommended for new development and
      cannot negotiate STARTTLS properly. It is confined to Infrastructure and reaches no
      shipped client package.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      M7.2: the Data Protection key ring is persisted to the database rather than to disk, so
      a second API instance can decrypt what the first one encrypted. A disk ring would make
      broker credentials unreadable after a container restart without a mounted volume.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <!--
      5.x here because EF Core's Design package requires it transitively, and central package
      management resolves one version for the whole repository.

      The generator project overrides this down to 4.14 with VersionOverride, and that
      direction matters: an analyzer built against a Roslyn NEWER than the host compiler fails
      to load outright, and all the consumer sees is "analyzer could not be loaded". A .NET 8
      SDK must be able to run a generator this repository builds on .NET 10.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Tooling">

    <!-- MIT, from Microsoft, and the parser the .NET SDK itself uses. AOT-friendly for M3.3. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <!--
      Apache-2.0 OR MPL-2.0. We take the Apache-2.0 arm, matching ADR-009.
    -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      M2.5 only, to read a Concordat message back over a protocol that is not AMQP 0-9-1.
      Both are test-only and never referenced by a shipped package, but both were licence-
      checked all the same: AMQPNetLite is Apache-2.0, MQTTnet is MIT. MQTTnet declares a
      licence FILE rather than an SPDX expression, which is the same shape that concealed
      JsonSchema.Net's maintenance fee, so the file itself was read rather than the metadata
      trusted.
    -->
    <PackageVersion Include="AMQPNetLite" Version="2.5.3" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>
  <ItemGroup Label="Transitive pins">
    <!--
      Testcontainers 4.13.0 drags in SSH.NET 2025.1.0, which carries a high-severity
      advisory (GHSA-q939-rpr3-3284) that NuGet audit turns into a build error. Pinned
      forward to the patched release rather than suppressed: SSH.NET is only used by
      Testcontainers' docker-over-SSH transport, which we never touch, but a suppressed
      advisory stays suppressed long after it stops being harmless.

      CentralPackageTransitivePinningEnabled makes this pin apply to the transitive
      reference. Remove it once Testcontainers ships a version that requires the fix.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>