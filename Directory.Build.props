<Project>

  <!--
    Shared build settings for every project. Individual .csproj files should carry
    almost nothing beyond their references.
  -->

  <PropertyGroup Label="Language">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Correctness">
    <!--
      Warnings are errors from the first commit. Turning this on later means
      triaging hundreds at once, which nobody does, so the warnings just stay.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <!--
      Deterministic output so the same source produces byte-identical assemblies.
      ContinuousIntegrationBuild normalises embedded paths and is set by CI only —
      switching it on locally breaks debugger source lookup.
    -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    NuGet lock files (RestorePackagesWithLockFile) were evaluated for M13's supply-chain
    hardening but not adopted: on the SDK this repository builds with (10.0.301), enabling it
    repo-wide breaks `dotnet restore`/`dotnet build` against Concordat.slnx outright — solution-
    level restore fails with NuGet.Frameworks.FrameworkException "Invalid framework identifier
    ''" (NuGet.targets:198), reproducibly, and which project trips it moves around between runs.
    Restoring any single project directly, with the exact same lock-file setting, works fine —
    this is isolated to the SDK's solution-level (.slnx) restore graph construction, not this
    repository's project files. Neither disabling restore parallelism (-p:RestoreDisableParallel)
    nor a single MSBuild node (-m:1) changes the outcome. A lock file nobody can restore against
    is worse than no lock file, so this stays off until a newer SDK fixes the underlying bug —
    nuget.config's <packageSourceMapping/> (see repo root) is the supply-chain control that
    shipped instead.
  -->


  <PropertyGroup Label="Packaging">
    <Product>Concordat</Product>
    <Authors>Rafael Camara</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RafaelJCamara/Concordat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RafaelJCamara/Concordat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Nothing publishes until M2 at the earliest; opt in per project. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Tests" Condition="$(MSBuildProjectName.EndsWith('Tests')) or '$(MSBuildProjectName)' == 'Concordat.Conformance'">
    <IsTestProject>true</IsTestProject>
    <!-- Public XML docs on test projects are noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
