# Keeping the build context small matters more than usual here: the CLI image is
# built on every CI run, and bin/obj from a local build would be copied in and then
# fight the container's own restore.
**/bin/
**/obj/
**/.vs/
**/.idea/

.git/
.github/
tests/
docs/
scripts/
artifacts/

# The CLI image needs nothing from the Angular app, and node_modules is tens of thousands of
# files — by far the largest thing that would otherwise be uploaded as build context on every
# CI run.
web/

*.user
*.suo
