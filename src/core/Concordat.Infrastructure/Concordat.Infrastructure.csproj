<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Concordat.Application\Concordat.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The repositories are internal on purpose: they are resolved through DI inside this
      assembly and nothing above should construct them. The integration tests do, so they can
      exercise a handler against a real database without standing up a host.
    -->
    <InternalsVisibleTo Include="Concordat.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- M7.1: the broker health check completes a real AMQP handshake. -->
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- M7.5: SMTP delivery and the options binding the channels read their configuration from. -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- M8.1: PasswordHasher<T> and nothing else from Identity. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
  </ItemGroup>

</Project>
