<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="OpenAPI">
    <!--
      The OpenAPI document is a normative artifact (ADR-019): non-.NET clients are generated
      from it, so it is committed and CI fails when the build regenerates something different.
      Emitting it on every build is what makes the drift gate meaningful - a spec refreshed by
      hand only ever documents what someone remembered to update.
    -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\..\docs\api</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- M9.1: wraps the key ring with an Azure Key Vault key. Reached only when configured. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Concordat.Application\Concordat.Application.csproj" />
    <ProjectReference Include="..\..\core\Concordat.Infrastructure\Concordat.Infrastructure.csproj" />
    <ProjectReference Include="..\..\formats\Concordat.Formats.Avro\Concordat.Formats.Avro.csproj" />
    <ProjectReference Include="..\..\formats\Concordat.Formats.Json\Concordat.Formats.Json.csproj" />
    <ProjectReference Include="..\..\formats\Concordat.Formats.Protobuf\Concordat.Formats.Protobuf.csproj" />
  </ItemGroup>

  <!--
    Roslyn writes each referenced project's XML documentation file using the platform's own
    newline, and those doc comments become `description` values in the document below. So a
    summary spanning two lines arrives here as an escaped \r\n on Windows and an escaped \n on
    Linux — sequences INSIDE JSON strings, not line endings, which is why .gitattributes cannot
    normalise them and why the drift gate could not be satisfied on both platforms at once: the
    committed document matched whichever OS last regenerated it and failed on the other. CI runs
    on Linux and the repository stores LF, so LF wins here too.
  -->
  <UsingTask TaskName="NormaliseEscapedNewlines" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Document ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(Document);
        var normalised = text.Replace("\\r\\n", "\\n");
        if (!string.Equals(text, normalised, System.StringComparison.Ordinal))
        {
            System.IO.File.WriteAllText(Document, normalised);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="NameOpenApiDocumentForTheProtocol" AfterTargets="Build"
          Condition="Exists('$(OpenApiDocumentsDirectory)\$(AssemblyName).json')">
    <!--
      The generator names the file after the assembly. The protocol is versioned by its API
      version, not by which host emitted it, so it is renamed to match DESIGN §5 and the path
      every SDK generator will be pointed at.
    -->
    <Move SourceFiles="$(OpenApiDocumentsDirectory)\$(AssemblyName).json"
          DestinationFiles="$(OpenApiDocumentsDirectory)\openapi.v1.json" />

    <NormaliseEscapedNewlines Document="$(OpenApiDocumentsDirectory)\openapi.v1.json" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

</Project>
