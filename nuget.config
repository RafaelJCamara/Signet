<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear/> then exactly one source: without it, any source configured in a user- or
    machine-level NuGet.Config (%AppData%\NuGet\NuGet.Config, a corporate feed, a typo-squat
    someone added while debugging something unrelated) is also consulted for every package
    this repository restores, and NuGet's default is to take a matching package from
    whichever configured source answers first — not preferentially from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Belt-and-suspenders with the single source above: package source mapping pins every
    package ID prefix we actually use to nuget.org specifically, so even a future second
    source added to this file cannot silently supply a package under a name it does not own.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
