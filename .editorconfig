root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{md,markdown}]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

# ---------------------------------------------------------------- C# style
[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Naming: interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# ------------------------------------------------------- analyzer severities
# CA1062 null-checks every public parameter; nullable reference types already
# encode that, and the pair together produce noise on every public method.
dotnet_diagnostic.CA1062.severity = none
# CA1848 (LoggerMessage delegates) is a real perf point but not on the hot path
# for a registry that is out of the delivery path after warm-up (DESIGN §5).
dotnet_diagnostic.CA1848.severity = suggestion

[tests/**/*.cs]
# Test projects: naming freedom for Given_When_Then style, no doc comments.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none

[**/Migrations/*.cs]
# EF Core writes these; they are a record of what was applied, not hand-maintained source.
# Reformatting them to house style would make every regeneration a spurious diff, and
# editing them after they ship is how a database and its migration history diverge.
generated_code = true
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CS1591.severity = none
